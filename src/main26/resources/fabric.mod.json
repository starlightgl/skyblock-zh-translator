{
	"schemaVersion": 1,
	"id": "hypixel-npc-and-items-translate",
	"version": "${version}",
	"name": "SkyBlock 中文翻译 (SkyBlock ZH Translator)",
	"description": "Hypixel SkyBlock 中文翻译：NPC 对话、物品描述、计分板、全息文字及其他模组提示。内置固定短语库、术语表与附魔说明，其余内容通过国内 OpenAI 兼容 AI 接口翻译。基于 KALPSIZ__ 的 NPC & Items Translator。",
	"authors": [
		"KALPSIZ__",
		"starlightgl"
	],
	"contact": {
		"sources": "https://github.com/starlightgl/skyblock-zh-translator"
	},
	"license": "GPL-3.0-only",
	"icon": "assets/hypixel-npc-and-items-translate/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.npctranslator.NPCTranslatorClient"
		],
		"modmenu": [
			"com.npctranslator.config.ModMenuIntegration"
		]
	},
	"mixins": [
		"npc_translator.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": "${minecraft_dep}",
		"java": ">=21",
		"fabric-api": "*",
		"yet_another_config_lib_v3": ">=3.5.0"
	}
}